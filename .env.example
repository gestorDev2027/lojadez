# Copie para .env e preencha. O .env nunca vai para o Git.

# ── A loja ──
LOJA_NOME=Wolf & Co
# Endereço público do site, sem barra no fim. Em produção, https (a InfinitePay só manda webhook para https).
SITE_URL=http://localhost:8000
# Senha da área do vendedor (/vendedor). Vazia: a área fica fechada.
VENDEDOR_SENHA=
# WhatsApp do atendimento: DDI + DDD + número, só dígitos.
LOJA_WHATSAPP=5511983910543
# Fim da promoção (contagem regressiva da página). Vazio: sem contagem. Use só uma data real.
LOJA_PROMO_ATE=2026-11-30T23:59:59-03:00
# CEP de onde sai o envio (origem da cotação da Loggi).
LOJA_ORIGEM_CEP=01310100
# Rodapé da página.
EMPRESA_RAZAO_SOCIAL=
EMPRESA_CNPJ=
EMPRESA_EMAIL=
# Rastreamento (vazio: não carrega nada).
META_PIXEL_ID=
GTM_ID=

# ── O produto e as ofertas (confira antes de vender) ──
PRODUTO_REFIS=22
# Preço de cada oferta, em centavos (1, 2 e 3 kits).
OFERTA_KIT1_CENTAVOS=2690
OFERTA_KIT2_CENTAVOS=4790
OFERTA_KIT3_CENTAVOS=6490
# Peso de UM kit embalado, em gramas, e medidas (comprimento x largura x altura, em cm).
PRODUTO_PESO_G=300
PRODUTO_DIMENSOES_CM=32x17x5

# ── Loggi (frete) ──
# simulado (conta local, sem a Loggi) | staging (stg.api.loggi.com) | producao (api.loggi.com)
LOGGI_AMBIENTE=simulado
LOGGI_CLIENT_ID=
LOGGI_CLIENT_SECRET=
# O código numérico da sua empresa na Loggi.
LOGGI_COMPANY_ID=
# Os códigos de serviço (externalServiceId) que a Loggi passa na homologação, separados por vírgula.
LOGGI_SERVICOS=

# ── InfinitePay (pagamento) ──
# simulado (página de pagamento de mentira da própria loja) | real
INFINITEPAY_AMBIENTE=simulado
# Sua InfiniteTag, sem o $ (obrigatória no modo real: é com ela que a loja confere os pagamentos).
INFINITEPAY_HANDLE=
# A API Key do Checkout Integrado (começa com inchk_). Opcional, mas recomendada: com ela cada link vale por
# INFINITEPAY_VALIDADE_HORAS, aceita um pagamento só e Pix + cartão.
INFINITEPAY_API_KEY=
INFINITEPAY_VALIDADE_HORAS=48

# ── Banco ──
# Vazio: SQLite em dados/loja.db. Em produção, o Postgres (ex.: Supabase, Render).
DATABASE_URL=

# Copie para .env. O .env nunca vai para o Git.
#
# Com o Supabase, basta o DATABASE_URL (no fim do arquivo): o resto muda em /vendedor → Configurações, e as chaves
# ficam no Vault. As variáveis abaixo só valem enquanto não forem salvas pela tela (servem para o SQLite local).
# O acesso à área do vendedor é criado com: .venv\Scripts\python -m servidor.admin

# ── A loja ──
LOJA_NOME=Wolf & Co
# Endereço público do site, sem barra no fim. Em produção, https (a InfinitePay só manda webhook para https).
SITE_URL=http://localhost:8000
# WhatsApp do atendimento: DDI + DDD + número, só dígitos.
LOJA_WHATSAPP=5511983910543
# Fim da promoção (contagem regressiva da página). Vazio: sem contagem. Use só uma data real.
LOJA_PROMO_ATE=2026-11-30T23:59:59-03:00
# CEP de onde sai o envio (origem da cotação da Loggi).
LOJA_ORIGEM_CEP=01310100
# Quem envia (vai no envio e na etiqueta da Loggi). Rua, bairro e cidade vêm do LOJA_ORIGEM_CEP.
LOJA_REMETENTE_NOME=
# CPF ou CNPJ de quem envia, só números.
LOJA_REMETENTE_DOCUMENTO=
LOJA_REMETENTE_TELEFONE=
LOJA_ORIGEM_NUMERO=
LOJA_ORIGEM_COMPLEMENTO=
# Como o pacote vai declarado (declaração de conteúdo, sem nota fiscal).
LOGGI_DESCRICAO_CONTEUDO=Kit barbeador com aparelho e refis de lâminas
# Rodapé da página.
EMPRESA_RAZAO_SOCIAL=
EMPRESA_CNPJ=
EMPRESA_EMAIL=
# Rastreamento (vazio: não carrega nada).
META_PIXEL_ID=
GTM_ID=

# ── O produto e as ofertas: são os PADRÕES. Refis, preços, selos e foto mudam pela área do vendedor ──
PRODUTO_REFIS=19
# Preço de cada oferta, em centavos (1, 2 e 3 kits).
OFERTA_KIT1_CENTAVOS=2390
OFERTA_KIT2_CENTAVOS=4490
OFERTA_KIT3_CENTAVOS=6290
# Peso de UM kit embalado, em gramas, e medidas (comprimento x largura x altura, em cm).
PRODUTO_PESO_G=300
PRODUTO_DIMENSOES_CM=32x17x5

# ── Loggi (frete) ──
# simulado (conta local, sem a Loggi) | staging (stg.api.loggi.com) | producao (api.loggi.com)
LOGGI_AMBIENTE=simulado
LOGGI_CLIENT_ID=
LOGGI_CLIENT_SECRET=
# O código numérico da sua empresa na Loggi.
LOGGI_COMPANY_ID=
# Os códigos de serviço (externalServiceId) que a Loggi passa na homologação, separados por vírgula.
LOGGI_SERVICOS=
# sim: quando o pagamento é confirmado, a loja já cria o envio na Loggi e a etiqueta fica pronta no pedido. Se a Loggi
# recusar (endereço, remetente), o pedido mostra o motivo na área do vendedor e o envio é criado à mão.
LOGGI_ENVIO_AUTOMATICO=nao

# ── InfinitePay (pagamento) ──
# simulado (página de pagamento de mentira da própria loja) | real
INFINITEPAY_AMBIENTE=simulado
# Sua InfiniteTag, sem o $ (obrigatória no modo real: é com ela que a loja confere os pagamentos).
INFINITEPAY_HANDLE=
# A API Key do Checkout Integrado (começa com inchk_). Opcional, mas recomendada: com ela cada link vale por
# INFINITEPAY_VALIDADE_HORAS, aceita um pagamento só e Pix + cartão.
INFINITEPAY_API_KEY=
INFINITEPAY_VALIDADE_HORAS=48
# Desconto para quem paga no Pix, em % (0: sem). A InfinitePay só aplica com a API Key.
INFINITEPAY_DESCONTO_PIX=0

# ── Banco ──
# Vazio: SQLite em dados/loja.db. Com o Supabase: Connect > Session pooler (porta 5432), trocando [YOUR-PASSWORD]
# pela senha do banco. As tabelas ficam no esquema "loja" (fora da API REST do Supabase), com RLS ligado.
DATABASE_URL=

# Copie para .env e preencha. O .env nunca vai para o Git.

# ── A loja ──
LOJA_NOME=Barba Feita
# Endereço público do site, sem barra no fim. Em produção, https (a InfinitePay só manda webhook para https).
SITE_URL=http://localhost:8000
# Senha da área do vendedor (/vendedor). Vazia: a área fica fechada.
VENDEDOR_SENHA=
LOJA_QUANTIDADE_MAXIMA=10
# CEP de onde sai o envio (origem da cotação da Loggi).
LOJA_ORIGEM_CEP=01310100

# ── O produto (confira antes de vender) ──
PRODUTO_PRECO_CENTAVOS=3990
# Peso de uma unidade embalada, em gramas, e medidas da embalagem (comprimento x largura x altura, em cm).
PRODUTO_PESO_G=200
PRODUTO_DIMENSOES_CM=26x15x4
# PRODUTO_NOME=Kit Lâminas de Barbear MADE basics
# PRODUTO_RESUMO=Aparelho com cabo e cargas de reposição com lâminas múltiplas e tira lubrificante.

# ── Loggi (frete) ──
# simulado (conta local, sem a Loggi) | staging (stg.api.loggi.com) | producao (api.loggi.com)
LOGGI_AMBIENTE=simulado
LOGGI_CLIENT_ID=
LOGGI_CLIENT_SECRET=
# O código numérico da sua empresa na Loggi.
LOGGI_COMPANY_ID=
# Os códigos de serviço (externalServiceId) que a Loggi passa na homologação, separados por vírgula.
LOGGI_SERVICOS=

# ── InfinitePay (pagamento) ──
# simulado (página de pagamento de mentira da própria loja) | real
INFINITEPAY_AMBIENTE=simulado
# Sua InfiniteTag, sem o $.
INFINITEPAY_HANDLE=
# Opcional: com ela, cada link vale por INFINITEPAY_VALIDADE_HORAS, aceita um pagamento só e Pix + cartão.
INFINITEPAY_API_KEY=
INFINITEPAY_VALIDADE_HORAS=48

# ── Banco ──
# Vazio: SQLite em dados/loja.db. Em produção, o Postgres (ex.: Supabase, Render).
DATABASE_URL=
